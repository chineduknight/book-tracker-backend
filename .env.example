# Copy to .env for local development. Never commit real credentials.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Local MongoDB (no credentials). For Atlas use a mongodb+srv:// URI in your untracked .env.
MONGODB_URI=mongodb://127.0.0.1:27017/book-tracker

# Comma-separated list of exact browser origins allowed by CORS. "*" is rejected.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Required. Secret that signs JWT access tokens: base64url, at least 32 random bytes. There is no
# default. Generate it straight into .env so it is never printed:
#   echo "JWT_ACCESS_TOKEN_SECRET=$(node -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('base64url'))")" >> .env
JWT_ACCESS_TOKEN_SECRET=

# Integration tests only (npm run test:integration). Tests always use the book-tracker-test
# database and delete its users and sessions.
# MONGODB_TEST_URI=mongodb://127.0.0.1:27017/book-tracker-test
