# Copy to .env for local development. Never commit real credentials.

# development | test | production
NODE_ENV=development

# HTTP port the API listens on
PORT=3000

# Local MongoDB (no credentials). For Atlas use a mongodb+srv:// URI in your untracked .env.
MONGODB_URI=mongodb://127.0.0.1:27017/book-tracker

# Comma-separated list of exact browser origins allowed by CORS. "*" is rejected.
CORS_ORIGIN=http://localhost:5173

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
