meta {
  name: Empty archive
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/export/archive
  body: none
  auth: bearer
}

auth:bearer {
  token: {{exportAccessToken}}
}

tests {
  test("is a private book-tracker-export download", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getHeader("content-type")).to.equal("application/json; charset=utf-8");
    expect(res.getHeader("content-disposition")).to.match(
      /^attachment; filename="book-tracker-export-\d{4}-\d{2}-\d{2}\.\w+"$/,
    );
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });

  test("contains the profile and every section, empty", function () {
    const archive = res.getBody().data;
    expect(archive.schemaVersion).to.equal(1);
    expect(archive.profile.id).to.equal(bru.getVar("exportUserId"));
    expect(Object.keys(archive.profile).sort()).to.eql(["createdAt", "email", "id", "name"]);
    for (const section of [
      "books", "locations", "copies", "readingSessions", "notes",
      "categories", "collections", "wishlist", "loans",
    ]) {
      expect(archive[section]).to.eql([]);
    }
  });
}

docs {
  # GET /api/v1/export/archive

  The complete JSON archive, `{ "data": ArchiveDto }`, as an attachment
  (`book-tracker-export-YYYY-MM-DD.json`). No query parameters. Sections are ordered oldest first
  and include soft-deleted records with `deletedAt`. Never contains credentials, tokens, sessions
  or internal database fields. Too much data returns `413 EXPORT_TOO_LARGE` instead of a file.
}
