meta {
  name: Archive with query parameters
  type: http
  seq: 19
}

get {
  url: {{baseUrl}}/export/archive?since=2026-01-01
  body: none
  auth: bearer
}

params:query {
  since: 2026-01-01
}

auth:bearer {
  token: {{exportAccessToken}}
}

tests {
  test("rejects every query parameter as JSON, not as a file", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([{ field: "since", message: "Unknown field" }]);
    expect(res.getHeader("content-disposition")).to.equal(undefined);
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}
