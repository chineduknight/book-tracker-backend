meta {
  name: Archive without token
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/export/archive
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}
