meta {
  name: Register export reader
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Export Reader",
    "email": "{{exportEmail}}",
    "password": "{{exportPassword}}"
  }
}

script:pre-request {
  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  bru.setVar("exportEmail", `bruno-export-${runId}@example.test`);
  bru.setVar("exportPassword", `disposable-${runId}`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("exportAccessToken", res.getBody().data.tokens.accessToken);
    bru.setVar("exportUserId", res.getBody().data.user.id);
  }
}

tests {
  test("creates the disposable reader used by this folder", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
