meta {
  name: Unknown route
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/this-route-does-not-exist
  body: none
  auth: none
}

assert {
  res.status: eq 404
  res.body.error.code: eq "NOT_FOUND"
  res.body.error.requestId: isString
}

docs {
  Demonstrates the standard error envelope returned for unknown routes.
}
