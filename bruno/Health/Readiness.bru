meta {
  name: Readiness
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/ready
  body: none
  auth: none
}

tests {
  test("returns 200 when MongoDB is connected and its indexes are verified, otherwise 503", function () {
    expect([200, 503]).to.include(res.getStatus());
  });

  test("returns exactly the documented body for its status", function () {
    const body = res.getBody();
    if (res.getStatus() === 200) {
      expect(body).to.eql({ data: { status: "ready", checks: { database: "connected" } } });
      return;
    }
    expect(body.error.code).to.equal("SERVICE_UNAVAILABLE");
    expect(body.error.requestId).to.equal(res.getHeader("x-request-id"));
    expect([
      "Service is not ready: database is not connected",
      "Service is not ready: required database indexes are not verified",
    ]).to.include(body.error.message);
    expect(Object.keys(body.error).sort()).to.eql(["code", "message", "requestId"]);
    expect(Object.keys(body)).to.eql(["error"]);
  });

  test("is not cacheable and carries a request id", function () {
    expect(res.getHeader("cache-control")).to.equal("no-store");
    expect(res.getHeader("x-request-id")).to.be.a("string").and.not.be.empty;
  });
}

docs {
  # GET /api/v1/ready

  Readiness probe and the host's health-check path. Returns 200 only while MongoDB is fully
  connected **and** a read-only check has found every required index (unique, partial and TTL
  indexes enforce invariants such as one active loan per copy); otherwise 503. No
  authentication. `HEAD` returns the same status without a body. Both responses send
  `Cache-Control: no-store`. Use this path, not `/health`, for host health checks.

  **200 OK**

  ```json
  { "data": { "status": "ready", "checks": { "database": "connected" } } }
  ```

  **503 Service Unavailable**

  ```json
  {
    "error": {
      "code": "SERVICE_UNAVAILABLE",
      "message": "Service is not ready: database is not connected",
      "requestId": "c10e79cf-2e60-4a2c-9f35-1ca9cf5bfcb3"
    }
  }
  ```

  While required indexes are missing or conflicting (production never builds them itself; see
  `docs/index-operations.md`), the message is
  `"Service is not ready: required database indexes are not verified"`.

  Stop MongoDB (or point `MONGODB_URI` at an unused port) to see the 503 response.

  DTO: `ReadinessResponseBody` in `src/modules/health/health.dto.ts`; error body:
  `ErrorResponseBody` in `src/shared/errors.ts`. Contract: `docs/api-contract.md`.
}
