meta {
  name: Get location with invalid id
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/locations/home
  body: none
  auth: bearer
}

auth:bearer {
  token: {{locationsAccessToken}}
}

tests {
  test("returns 400 with a locationId detail", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "locationId", message: "must be a 24-character hexadecimal id" },
    ]);
  });
}
