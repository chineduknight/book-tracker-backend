meta {
  name: Get missing location
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/locations/64b7f0c2a1b2c3d4e5f60718
  body: none
  auth: bearer
}

auth:bearer {
  token: {{locationsAccessToken}}
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Location not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
