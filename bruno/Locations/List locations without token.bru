meta {
  name: List locations without token
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/locations
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody().error.code).to.equal("UNAUTHENTICATED");
  });
}
