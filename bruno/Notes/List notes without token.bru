meta {
  name: List notes without token
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/notes
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
  });
}
