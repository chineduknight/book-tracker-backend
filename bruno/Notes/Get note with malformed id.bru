meta {
  name: Get note with malformed id
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/notes/not-an-id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{notesAccessToken}}
}

tests {
  test("returns 400 naming noteId", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "noteId", message: "must be a 24-character hexadecimal id" },
    ]);
  });
}
