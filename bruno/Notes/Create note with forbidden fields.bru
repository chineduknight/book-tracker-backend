meta {
  name: Create note with forbidden fields
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/books/{{notesBookId}}/notes
  body: json
  auth: bearer
}

auth:bearer {
  token: {{notesAccessToken}}
}

body:json {
  {
    "kind": "note",
    "content": "Mine",
    "ownerId": "64b7f0c2a1b2c3d4e5f60718",
    "deletedAt": null
  }
}

tests {
  test("rejects ownership and lifecycle fields as unknown", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.code).to.equal("VALIDATION_ERROR");
    expect(res.getBody().error.details).to.eql([
      { field: "ownerId", message: "Unknown field" },
      { field: "deletedAt", message: "Unknown field" },
    ]);
  });
}
