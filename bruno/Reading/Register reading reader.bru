meta {
  name: Register reading reader
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Reading Reader",
    "email": "{{readingEmail}}",
    "password": "{{readingPassword}}"
  }
}

script:pre-request {
  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  bru.setVar("readingEmail", `bruno-reading-${runId}@example.test`);
  bru.setVar("readingPassword", `disposable-${runId}`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("readingAccessToken", res.getBody().data.tokens.accessToken);
  }
}

tests {
  test("creates the disposable reader used by this folder", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
