meta {
  name: Get missing reading session
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/reading-sessions/64b7f0c2a1b2c3d4e5f60718
  body: none
  auth: bearer
}

auth:bearer {
  token: {{readingAccessToken}}
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Reading session not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
  Another reader's session, or a session of a deleted book, returns exactly this response.
}
