meta {
  name: Record progress beyond page count
  type: http
  seq: 6
}

patch {
  url: {{baseUrl}}/reading-sessions/{{readingSessionId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{readingAccessToken}}
}

body:json {
  {
    "progress": { "unit": "pages", "value": 400 }
  }
}

tests {
  test("returns 400 because the book has 310 pages", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "progress.value", message: "must not exceed the book's page count" },
    ]);
  });
}
