meta {
  name: Login wrong password
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{testEmail}}",
    "password": "{{testPassword}}-wrong"
  }
}

tests {
  test("returns 401 INVALID_CREDENTIALS", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getBody()).to.eql({
      error: {
        code: "INVALID_CREDENTIALS",
        message: "Email or password is incorrect",
        requestId: res.getHeader("x-request-id"),
      },
    });
  });
}

docs {
  An unknown email returns exactly this response too, so the API does not reveal which
  accounts exist through login.
}
