meta {
  name: Login malformed JSON
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/auth/login
  body: text
  auth: none
}

headers {
  Content-Type: application/json
}

body:text {
  {"email": "jane@example.com", "password":
}

tests {
  test("returns 400 INVALID_JSON before reaching the auth routes", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody()).to.eql({
      error: {
        code: "INVALID_JSON",
        message: "Request body is not valid JSON",
        requestId: res.getHeader("x-request-id"),
      },
    });
  });

  test("is not cacheable even though the body parser rejected it", function () {
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });
}

docs {
  The JSON body parser runs before any route, so this error is produced outside the auth router.
  Every `/api/v1/auth/*` response still sends `Cache-Control: no-store`, including body-parser
  errors (400 `INVALID_JSON`, 413 `PAYLOAD_TOO_LARGE`, 415 `UNSUPPORTED_MEDIA_TYPE`) and CORS
  preflight.
}
