meta {
  name: List books without token
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/books
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
    expect(res.getBody().error.code).to.equal("UNAUTHENTICATED");
  });
}
