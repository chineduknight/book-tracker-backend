meta {
  name: Get book
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/books/{{bookId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{booksAccessToken}}
}

tests {
  test("returns the book", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.id).to.equal(bru.getVar("bookId"));
    expect(res.getBody().data.title).to.equal("The Hobbit");
  });
}

docs {
  # GET /api/v1/books/:bookId

  **200 OK**: `{ "data": BookDto }`. **Errors**: `400 VALIDATION_ERROR` (malformed id),
  `401 UNAUTHENTICATED`, `404 NOT_FOUND` (missing, deleted or another reader's book; identical).
}
