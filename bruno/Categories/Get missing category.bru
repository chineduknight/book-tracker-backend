meta {
  name: Get missing category
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/categories/64b7f0c2a1b2c3d4e5f60718
  body: none
  auth: bearer
}

auth:bearer {
  token: {{categoriesAccessToken}}
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Category not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
  Another reader's category and a deleted category return exactly this response.
}
