meta {
  name: Delete category
  type: http
  seq: 19
}

delete {
  url: {{baseUrl}}/categories/{{categoriesGroupId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{categoriesAccessToken}}
}

tests {
  test("soft-deletes the group with 204 and no body", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody() ?? "").to.equal("");
  });
}

docs {
  # DELETE /api/v1/categories/:categoryId

  Soft deletion: the category and its memberships are hidden everywhere, the stored record
  stays, no book is touched, and the name becomes available again. Repeating returns 404.
}
