meta {
  name: Get category with malformed id
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/categories/not-an-id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{categoriesAccessToken}}
}

tests {
  test("returns 400 naming categoryId", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "categoryId", message: "must be a 24-character hexadecimal id" },
    ]);
  });
}
