meta {
  name: Register categories reader
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Category Reader",
    "email": "{{categoriesEmail}}",
    "password": "{{categoriesPassword}}"
  }
}

script:pre-request {
  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  bru.setVar("categoriesEmail", `bruno-categories-${runId}@example.test`);
  bru.setVar("categoriesPassword", `disposable-${runId}`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("categoriesAccessToken", res.getBody().data.tokens.accessToken);
  }
}

tests {
  test("creates the disposable reader used by this folder", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
