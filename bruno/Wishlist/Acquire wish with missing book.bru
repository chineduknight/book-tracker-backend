meta {
  name: Acquire wish with missing book
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/wishlist/{{wishlistSecondItemId}}/acquisition
  body: json
  auth: bearer
}

auth:bearer {
  token: {{wishlistAccessToken}}
}

body:json {
  {
    "bookId": "64b7f0c2a1b2c3d4e5f60718"
  }
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Book not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
  Another reader's book or a deleted book returns exactly this response, and the wish stays wanted.
}
