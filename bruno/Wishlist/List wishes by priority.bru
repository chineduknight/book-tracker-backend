meta {
  name: List wishes by priority
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/wishlist?sort=priority&priority=high
  body: none
  auth: bearer
}

params:query {
  sort: priority
  priority: high
}

auth:bearer {
  token: {{wishlistAccessToken}}
}

tests {
  test("filters and orders by priority", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.map((item) => item.id)).to.eql([bru.getVar("wishlistItemId")]);
  });
}
