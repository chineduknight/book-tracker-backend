meta {
  name: Get missing wish
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/wishlist/64b7f0c2a1b2c3d4e5f60718
  body: none
  auth: bearer
}

auth:bearer {
  token: {{wishlistAccessToken}}
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Wishlist item not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
  Another reader's wish and a deleted wish return exactly this response.
}
