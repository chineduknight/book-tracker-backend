meta {
  name: List acquired wishes
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/wishlist?status=acquired
  body: none
  auth: bearer
}

params:query {
  status: acquired
}

auth:bearer {
  token: {{wishlistAccessToken}}
}

tests {
  test("lists only acquired items", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.map((item) => item.id)).to.eql([bru.getVar("wishlistItemId")]);
  });
}
