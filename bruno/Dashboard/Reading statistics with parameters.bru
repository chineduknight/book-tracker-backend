meta {
  name: Reading statistics with parameters
  type: http
  seq: 22
}

get {
  url: {{baseUrl}}/dashboard/reading-statistics?asOf=2026-01-11
  body: none
  auth: bearer
}

params:query {
  asOf: 2026-01-11
}

auth:bearer {
  token: {{dashboardAccessToken}}
}

tests {
  test("rejects every query parameter", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([{ field: "asOf", message: "Unknown field" }]);
  });
}
