meta {
  name: Create dashboard copy
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/books/{{dashboardBookId}}/copies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{dashboardAccessToken}}
}

body:json {
  {}
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("dashboardCopyId", res.getBody().data.id);
}

tests {
  test("creates the first copy", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
