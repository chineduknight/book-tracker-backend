meta {
  name: Recent activity with excessive limit
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/dashboard/recent-activity?limit=21
  body: none
  auth: bearer
}

params:query {
  limit: 21
}

auth:bearer {
  token: {{dashboardAccessToken}}
}

tests {
  test("returns 400 naming limit", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details[0].field).to.equal("limit");
  });
}
