meta {
  name: Summary with invalid asOf
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/dashboard/summary?asOf=2026-02-30
  body: none
  auth: bearer
}

params:query {
  asOf: 2026-02-30
}

auth:bearer {
  token: {{dashboardAccessToken}}
}

tests {
  test("returns 400 naming asOf", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "asOf", message: "must be an existing calendar date in YYYY-MM-DD format" },
    ]);
  });
}
