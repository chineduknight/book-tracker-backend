meta {
  name: Return loan again
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/loans/{{loansLoanId}}/return
  body: json
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

body:json {
  {
    "returnedOn": "2026-11-12"
  }
}

tests {
  test("is idempotent and does not touch the loan", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.updatedAt).to.equal(bru.getVar("loansReturnedUpdatedAt"));
  });
}
