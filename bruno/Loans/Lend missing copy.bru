meta {
  name: Lend missing copy
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/copies/64b7f0c2a1b2c3d4e5f60718/loans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

body:json {
  {
    "borrowerName": "Ada",
    "lentOn": "2026-11-14"
  }
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Copy not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}
