meta {
  name: Get missing loan
  type: http
  seq: 24
}

get {
  url: {{baseUrl}}/loans/64b7f0c2a1b2c3d4e5f60718
  body: none
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

tests {
  test("returns 404 NOT_FOUND", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody().error).to.eql({
      code: "NOT_FOUND",
      message: "Loan not found",
      requestId: res.getHeader("x-request-id"),
    });
  });
}

docs {
  Another reader's loan returns exactly this response.
}
