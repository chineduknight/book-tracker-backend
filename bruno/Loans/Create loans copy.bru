meta {
  name: Create loans copy
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/books/{{loansBookId}}/copies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

body:json {
  {
    "label": "Hardback"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("loansCopyId", res.getBody().data.id);
}

tests {
  test("creates the copy to lend", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
