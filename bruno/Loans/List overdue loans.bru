meta {
  name: List overdue loans
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/loans?status=overdue&asOf=2026-11-11
  body: none
  auth: bearer
}

params:query {
  status: overdue
  asOf: 2026-11-11
}

auth:bearer {
  token: {{loansAccessToken}}
}

tests {
  test("lists active loans due before the reference day", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.map((loan) => loan.id)).to.eql([bru.getVar("loansLoanId")]);
  });
}

docs {
  A loan due on the reference day is not yet overdue; a loan without a due date or already returned never is.
}
