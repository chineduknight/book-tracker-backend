meta {
  name: Lend copy with forbidden fields
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/copies/{{loansSecondCopyId}}/loans
  body: json
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

body:json {
  {
    "borrowerName": "Ada",
    "lentOn": "2026-11-14",
    "returnedOn": null,
    "ownerId": "64b7f0c2a1b2c3d4e5f60718"
  }
}

tests {
  test("rejects return and ownership fields as unknown", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "returnedOn", message: "Unknown field" },
      { field: "ownerId", message: "Unknown field" },
    ]);
  });
}
