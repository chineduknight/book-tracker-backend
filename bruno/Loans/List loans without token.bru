meta {
  name: List loans without token
  type: http
  seq: 28
}

get {
  url: {{baseUrl}}/loans
  body: none
  auth: none
}

tests {
  test("returns 401 UNAUTHENTICATED", function () {
    expect(res.getStatus()).to.equal(401);
    expect(res.getHeader("www-authenticate")).to.equal("Bearer");
  });
}
