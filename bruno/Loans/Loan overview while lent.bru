meta {
  name: Loan overview while lent
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/copies/{{loansCopyId}}/loan-overview
  body: none
  auth: bearer
}

auth:bearer {
  token: {{loansAccessToken}}
}

tests {
  test("reports the copy as on loan with the active loan", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().data.isOnLoan).to.equal(true);
    expect(res.getBody().data.activeLoan.id).to.equal(bru.getVar("loansLoanId"));
  });
}
