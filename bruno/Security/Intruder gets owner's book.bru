meta {
  name: Intruder gets owner's book
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/books/{{securityBookId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{securityIntruderToken}}
}

tests {
  test("answers 404 exactly like a missing record", function () {
    expect(res.getStatus()).to.equal(404);
    expect(res.getBody()).to.eql({
      error: { code: "NOT_FOUND", message: "Book not found", requestId: res.getHeader("x-request-id") },
    });
    expect(res.getHeader("cache-control")).to.equal("no-store");
  });

  test("is indistinguishable from the missing book", function () {
    const { requestId, ...error } = res.getBody().error;
    expect(error).to.eql(JSON.parse(bru.getVar("securityMissingBookError")));
  });
}

docs {
  Another reader's existing book: the same `404` as a missing one, so ids reveal nothing.
}
