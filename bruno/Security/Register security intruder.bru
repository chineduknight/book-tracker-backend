meta {
  name: Register security intruder
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Bruno Security Intruder",
    "email": "{{securityIntruderEmail}}",
    "password": "{{securityIntruderPassword}}"
  }
}

script:pre-request {
  const runId = `${Date.now()}-${Math.random().toString(36).slice(2, 10)}`;
  bru.setVar("securityIntruderEmail", `bruno-security-intruder-${runId}@example.test`);
  bru.setVar("securityIntruderPassword", `disposable-${runId}`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("securityIntruderToken", res.getBody().data.tokens.accessToken);
  }
}

tests {
  test("creates the disposable intruder used by this folder", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
