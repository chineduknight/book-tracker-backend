meta {
  name: Add owner's copy
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/books/{{securityBookId}}/copies
  body: json
  auth: bearer
}

auth:bearer {
  token: {{securityOwnerToken}}
}

body:json {
  {
    "label": "Private copy"
  }
}

script:post-response {
  if (res.getStatus() === 201) bru.setVar("securityCopyId", res.getBody().data.id);
}

tests {
  test("creates the owner's copy", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
