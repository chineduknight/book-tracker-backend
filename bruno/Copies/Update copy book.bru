meta {
  name: Update copy book
  type: http
  seq: 13
}

patch {
  url: {{baseUrl}}/copies/{{copyId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{copiesAccessToken}}
}

body:json {
  {
    "bookId": "{{copiesEbookId}}"
  }
}

tests {
  test("cannot move a copy to another book", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([{ field: "bookId", message: "Unknown field" }]);
  });
}
