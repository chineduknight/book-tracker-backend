meta {
  name: Create collection with forbidden fields
  type: http
  seq: 24
}

post {
  url: {{baseUrl}}/collections
  body: json
  auth: bearer
}

auth:bearer {
  token: {{collectionsAccessToken}}
}

body:json {
  {
    "name": "Mine",
    "ownerId": "64b7f0c2a1b2c3d4e5f60718",
    "bookIds": []
  }
}

tests {
  test("rejects ownership and membership fields as unknown", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "ownerId", message: "Unknown field" },
      { field: "bookIds", message: "Unknown field" },
    ]);
  });
}
