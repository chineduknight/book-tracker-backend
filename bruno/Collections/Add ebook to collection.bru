meta {
  name: Add ebook to collection
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/collections/{{collectionsGroupId}}/books/{{collectionsEbookId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{collectionsAccessToken}}
}

tests {
  test("adds the ebook with the same title", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody() ?? "").to.equal("");
  });
}
