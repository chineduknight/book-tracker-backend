meta {
  name: Get collection with malformed id
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/collections/not-an-id
  body: none
  auth: bearer
}

auth:bearer {
  token: {{collectionsAccessToken}}
}

tests {
  test("returns 400 naming collectionId", function () {
    expect(res.getStatus()).to.equal(400);
    expect(res.getBody().error.details).to.eql([
      { field: "collectionId", message: "must be a 24-character hexadecimal id" },
    ]);
  });
}
