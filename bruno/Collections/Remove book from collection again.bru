meta {
  name: Remove book from collection again
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/collections/{{collectionsGroupId}}/books/{{collectionsBookId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{collectionsAccessToken}}
}

tests {
  test("is idempotent: 204 for a book that is no longer a member", function () {
    expect(res.getStatus()).to.equal(204);
    expect(res.getBody() ?? "").to.equal("");
  });
}
